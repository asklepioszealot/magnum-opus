{
  "name": "magnum-opus",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/flashcards",
    "apps/study-shell",
    "apps/mcq",
    "packages/*"
  ],
  "scripts": {
    "dev:flashcards": "npm run dev --workspace apps/flashcards",
    "dev:study-shell": "npm run dev --workspace apps/study-shell",
    "dev:mcq": "npm run dev --workspace apps/mcq",
    "build:dist:flashcards": "npm run build:dist --workspace apps/flashcards",
    "build:dist:study-shell": "npm run build:dist --workspace apps/study-shell",
    "build:dist:mcq": "npm run build:dist --workspace apps/mcq",
    "build:desktop:flashcards": "npm run build:desktop --workspace apps/flashcards",
    "build:desktop:study-shell": "npm run build:desktop --workspace apps/study-shell",
    "build:desktop:mcq": "npm run build:desktop --workspace apps/mcq",
    "test:flashcards": "npm run test --workspace apps/flashcards",
    "test:study-shell": "npm run test --workspace apps/study-shell",
    "test:mcq": "npm run test --workspace apps/mcq",
    "release:flashcards": "npm run release --workspace apps/flashcards",
    "release:study-shell": "npm run release --workspace apps/study-shell",
    "release:mcq": "npm run release --workspace apps/mcq",
    "release:no-legacy:flashcards": "npm run release:no-legacy --workspace apps/flashcards",
    "release:no-legacy:study-shell": "npm run release:no-legacy --workspace apps/study-shell",
    "release:no-legacy:mcq": "npm run release:no-legacy --workspace apps/mcq",
    "release:with-legacy:flashcards": "npm run release:with-legacy --workspace apps/flashcards",
    "release:with-legacy:study-shell": "npm run release:with-legacy --workspace apps/study-shell",
    "release:with-legacy:mcq": "npm run release:with-legacy --workspace apps/mcq",
    "validate:set:flashcards": "npm run validate:set --workspace apps/flashcards",
    "validate:set:mcq": "npm run validate:set --workspace apps/mcq"
  }
}
